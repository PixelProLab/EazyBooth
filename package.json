{
  "name": "eazybooth",
  "version": "1.0.1",
  "description": "Reusable offline Windows event photobooth by Pixel Pro Lab",
  "author": "Pixel Pro Lab",
  "license": "ISC",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "start": "electron dist-electron/main/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:renderer": "tsc --noEmit && vite build",
    "build:icon": "node scripts/build-icon.cjs",
    "ensure:electron": "node node_modules/electron/install.js",
    "build:installer": "npm run ensure:electron && npm run build:icon && npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "test:electron": "node tests/electron-workflow.cjs",
    "test:installer": "node tests/installer.cjs",
    "verify": "npm run typecheck && npm test && npm run build:renderer",
    "test:frames": "node tests/frames-electron.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.0",
    "prettier": "3.6.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "0.29.0",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "com.pixelprolab.eazybooth",
    "productName": "EazyBooth",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "out/installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docs/HITI-SETUP.md",
        "to": "HITI-SETUP.txt"
      },
      {
        "from": "installer/HiTi Driver Downloads.url",
        "to": "HiTi Driver Downloads.url"
      },
      {
        "from": "docs/SONY-SETUP.md",
        "to": "SONY-SETUP.txt"
      },
      {
        "from": "installer/Sony Imaging Edge Desktop.url",
        "to": "Sony Imaging Edge Desktop.url"
      },
      {
        "from": "installer/Sony Imaging Edge Webcam.url",
        "to": "Sony Imaging Edge Webcam.url"
      },
      {
        "from": "templates",
        "to": "templates"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EazyBooth",
      "deleteAppDataOnUninstall": false,
      "artifactName": "EazyBooth-Setup-${version}.exe"
    },
    "npmRebuild": false
  }
}
